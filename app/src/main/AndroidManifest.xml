<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Reminders: the notification itself, the alarm that carries it, and the wake-ups that put
         the alarms back after a reboot, a clock change or an app update. VIBRATE is what lets the
         reminder channel buzz. Exact alarms are declared because a deadline reminder is worth firing
         at the minute it names; when the user withholds them the app still arms the reminder, just
         inside a window, and says so in the editor. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".TaskPlannerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TaskPlanner"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="31">

        <!-- The two languages the app is translated into, advertised to the system so Android 13+ offers them on
             its own App Languages screen. Hand-written rather than generated, and deliberately only these two:
             the system must not offer a language the app has no strings for, because choosing one would show the
             reader an English interface under a Russian label. `values-ru/` is what makes "ru" a promise the app
             keeps. -->

        <!-- Per-app language on the versions that have no framework support for it (API 24-32): AppCompat keeps
             the choice itself and restores it before the first activity is created. This declaration is what
             turns that storage on; without it the reader's pick would last until the process ended. On API 33+
             the system owns the value and the service is never started. The cost is one small SharedPreferences
             read on a cold start, which is measured rather than assumed (see the Stage 14 record). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- The task editor's Save and Cancel live in a footer outside the scrolling form, and the claim
                 that they stay reachable with the keyboard up only holds if the window is resized when the
                 input method opens — left undeclared, the platform decides per window, and the editor needs
                 the answer not to rest on a default it never asked for. Setting the mode from the fragment's
                 `onResume` was tried first and measured: the attribute changed and the layout did not — the
                 visible frame shrank to 728 px while Save's bottom stayed at 986 px, under the IME — so the
                 flag has to be on the window before the activity's first layout, which means here.
                 MainActivity hosts every screen, so this is an app-wide statement: the app resizes rather
                 than pans. What is measured is the editor — `theFooterStaysOnTheWindowWithTheKeyboardUp`
                 types into the title and asks the window for the height the input method took, then that
                 Save and the field are inside what is left. The list screen's behaviour under the same mode
                 is not asserted by any test in this repository, and no test in `TasksScreenInstrumentedTest`
                 or `TasksFabClearanceInstrumentedTest` raises a keyboard: that gap is recorded as open in
                 §20o of the redesign plan rather than being described here as covered. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Tapping a reminder opens the task it belongs to, or the habit it is owed — a habit's
                 reminder has no task behind it, so it points at the habit's own card. singleTop delivers
                 that link to the screen that is already showing instead of stacking a second copy of the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- One attribute per tag, which is how Android's matcher is built anyway: it combines the
                     data tags of a filter, so this still answers exactly the two links the app posts and no
                     other host. -->
                <data android:scheme="taskplanner" />
                <data android:host="task" />
                <data android:host="habit" />
            </intent-filter>
        </activity>

        <!-- Not exported: the alarm, the buttons and the boot/clock broadcasts all come from the
             system or from this app's own PendingIntents, never from another application. -->
        <receiver
            android:name=".data.reminder.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The one way a report leaves the app to be opened by something else. A `file://` uri would carry a
             path the receiving app cannot read since API 24 and would name a file by where it lives rather
             than by what was granted; a content uri minted here names one directory of the cache, and the
             read grant travels with the single intent that carries it. Not exported, and no other path rule
             is configured — see res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>