<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_tasks">

    <fragment
        android:id="@+id/navigation_tasks"
        android:name="com.taskplanner.ui.tasks.TasksFragment"
        android:label="@string/title_tasks">
        <action
            android:id="@+id/action_tasks_to_task_detail"
            app:destination="@id/navigation_task_detail" />
        <action
            android:id="@+id/action_tasks_to_archive"
            app:destination="@id/navigation_archive" />
        <action
            android:id="@+id/action_tasks_to_work_history"
            app:destination="@id/navigation_work_history" />
    </fragment>

    <!-- What the measurements add up to, and the place a closed one can be corrected. Its own
         destination rather than a block on the task screen: the history is the account of the whole
         profile, and a task screen only ever shows the part of it that belongs to one task. -->
    <fragment
        android:id="@+id/navigation_work_history"
        android:name="com.taskplanner.ui.work.WorkHistoryFragment"
        android:label="@string/history_title"
        tools:layout="@layout/fragment_work_history" />

    <fragment
        android:id="@+id/navigation_calendar"
        android:name="com.taskplanner.ui.calendar.CalendarFragment"
        android:label="@string/title_calendar">
        <action
            android:id="@+id/action_calendar_to_task_detail"
            app:destination="@id/navigation_task_detail" />
    </fragment>

    <fragment
        android:id="@+id/navigation_categories"
        android:name="com.taskplanner.ui.categories.CategoriesFragment"
        android:label="@string/title_categories">
        <action
            android:id="@+id/action_categories_to_category_detail"
            app:destination="@id/navigation_category_detail" />
    </fragment>

    <!-- What the measurements add up to. A category row and a task row are both a way into the list behind
         them: the dashboard is the screen that says where the time went, and the reader's next question is
         "show me that one". -->
    <fragment
        android:id="@+id/navigation_statistics"
        android:name="com.taskplanner.ui.statistics.StatisticsFragment"
        android:label="@string/title_statistics">
        <action
            android:id="@+id/action_statistics_to_category_tasks"
            app:destination="@id/categoryTasksFragment" />
        <action
            android:id="@+id/action_statistics_to_task_detail"
            app:destination="@id/navigation_task_detail" />
    </fragment>

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.taskplanner.ui.profile.ProfileFragment"
        android:label="@string/title_profile">
        <action
            android:id="@+id/action_profile_to_profile_selection"
            app:destination="@id/navigation_profile_selection" />
        <action
            android:id="@+id/action_profile_to_settings"
            app:destination="@id/navigation_settings" />
        <!-- The aims are the account's own business, so they are opened from the account rather than from a
             column of the task list — and only when there is an account to hold them. -->
        <action
            android:id="@+id/action_profile_to_goals"
            app:destination="@id/navigation_goals" />
        <!-- The routines are the account's own business for the same reason, and a habit reminder's deep link
             lands inside this same screen from the profile's own stack. -->
        <action
            android:id="@+id/action_profile_to_habits"
            app:destination="@id/navigation_habits" />
    </fragment>

    <fragment
        android:id="@+id/navigation_profile_selection"
        android:name="com.taskplanner.ui.profile.ProfileSelectionFragment"
        android:label="@string/title_profile_selection" />

    <fragment
        android:id="@+id/navigation_task_detail"
        android:name="com.taskplanner.ui.tasks.TaskDetailFragment"
        android:label="@string/title_task_detail">
        <argument
            android:name="taskId"
            app:argType="long" />
        <!-- What a reminder notification opens: the task that caused it. -->
        <deepLink
            android:id="@+id/deepLink_task_detail"
            app:uri="taskplanner://task/{taskId}" />
    </fragment>

    <fragment
        android:id="@+id/navigation_category_detail"
        android:name="com.taskplanner.ui.categories.CategoryDetailFragment"
        android:label="@string/title_category_detail">
        <argument
            android:name="categoryId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/categoryTasksFragment"
        android:name="com.taskplanner.ui.categories.CategoryTasksFragment"
        android:label="Category Tasks"
        tools:layout="@layout/fragment_category_tasks">
        <argument
            android:name="categoryId"
            app:argType="long" />
        <action
            android:id="@+id/action_categoryTasks_to_taskDetail"
            app:destination="@id/navigation_task_detail" />
    </fragment>


    <fragment
        android:id="@+id/navigation_archive"
        android:name="com.taskplanner.ui.archive.ArchiveFragment"
        android:label="@string/title_archive">
        <action
            android:id="@+id/action_archive_to_task_detail"
            app:destination="@id/navigation_task_detail" />
    </fragment>

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.taskplanner.ui.settings.SettingsFragment"
        android:label="@string/title_settings" />

    <!-- What the profile is working toward. Its own screen rather than a block on the task list because a
         goal is not a task: it is a figure the tasks answer to, and it is read from the account the way
         settings are. -->
    <fragment
        android:id="@+id/navigation_goals"
        android:name="com.taskplanner.ui.goals.GoalsFragment"
        android:label="@string/title_goals"
        tools:layout="@layout/fragment_goals">
        <action
            android:id="@+id/action_goals_to_goal_detail"
            app:destination="@id/navigation_goal_detail" />
        <action
            android:id="@+id/action_goals_to_goal_editor"
            app:destination="@id/navigation_goal_editor" />
    </fragment>

    <fragment
        android:id="@+id/navigation_goal_detail"
        android:name="com.taskplanner.ui.goals.GoalDetailFragment"
        android:label="@string/title_goal_detail"
        tools:layout="@layout/fragment_goal_detail">
        <argument
            android:name="goalId"
            app:argType="long" />
        <action
            android:id="@+id/action_goal_detail_to_goal_editor"
            app:destination="@id/navigation_goal_editor" />
        <action
            android:id="@+id/action_goal_detail_to_task_detail"
            app:destination="@id/navigation_task_detail" />
    </fragment>

    <!-- The one form for setting an aim and moving one. The id defaults to the value no device ever gave a
         row, so the list's "add" button needs no second destination to open an empty form. -->
    <fragment
        android:id="@+id/navigation_goal_editor"
        android:name="com.taskplanner.ui.goals.GoalEditorFragment"
        android:label="@string/title_goal_editor"
        tools:layout="@layout/fragment_goal_editor">
        <argument
            android:name="goalId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <!-- The routines the profile is keeping. Its own screen rather than a block on the task list because a
         habit is not a task: it is a schedule the days answer to, and it is read from the account the way
         goals and settings are. -->
    <fragment
        android:id="@+id/navigation_habits"
        android:name="com.taskplanner.ui.habits.HabitsFragment"
        android:label="@string/title_habits"
        tools:layout="@layout/fragment_habits">
        <action
            android:id="@+id/action_habits_to_habit_detail"
            app:destination="@id/navigation_habit_detail" />
        <action
            android:id="@+id/action_habits_to_habit_editor"
            app:destination="@id/navigation_habit_editor" />
    </fragment>

    <fragment
        android:id="@+id/navigation_habit_detail"
        android:name="com.taskplanner.ui.habits.HabitDetailFragment"
        android:label="@string/title_habit_detail"
        tools:layout="@layout/fragment_habit_detail">
        <argument
            android:name="habitId"
            app:argType="long" />
        <!-- What a habit reminder opens: the habit that owed the day. The link is by row id rather than uuid
             because it is resolved on the device that stored the row, exactly as a task link is, and the
             scheduler that posts the notification only ever knows the id it read the habit from. -->
        <deepLink
            android:id="@+id/deepLink_habit_detail"
            app:uri="taskplanner://habit/{habitId}" />
        <action
            android:id="@+id/action_habit_detail_to_habit_editor"
            app:destination="@id/navigation_habit_editor" />
    </fragment>

    <!-- The one form for starting a habit and moving its schedule, in the same shape as the goal editor: an id
         no device ever gave a row is how the graph says "a new habit". -->
    <fragment
        android:id="@+id/navigation_habit_editor"
        android:name="com.taskplanner.ui.habits.HabitEditorFragment"
        android:label="@string/title_habit_editor"
        tools:layout="@layout/fragment_habit_editor">
        <argument
            android:name="habitId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

</navigation> 