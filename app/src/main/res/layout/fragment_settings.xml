<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.settings.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_normal"
        android:paddingBottom="@dimen/spacing_normal">

        <!-- The screen's name, in the role every other bottom-bar screen carries it in. -->
        <TextView
            android:id="@id/settingsTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small"
            android:text="@string/title_settings"
            android:textAppearance="@style/TextAppearance.TaskPlanner.Headline" />

        <!-- `Widget.TaskPlanner.Card` rather than nothing: an unstyled MaterialCardView inherits whatever the
             theme's default card is, which is how three panels on this screen ended up with a different
             corner and a different lift from every other panel in the app. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.TaskPlanner.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_horizontal">

                <TextView
                    style="@style/Widget.TaskPlanner.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_account" />

                <!-- Which of the four states this build is in, named before anything else: a reader who sees a
                     disabled button and no reason concludes the app is broken. Stage 8a hid the whole section
                     when Firebase was absent, which hid the feature along with the configuration.
                     Body-medium in the card's own ink, not `SectionLabel`: the label role is 11sp, all-caps and
                     secondary ink — the smallest and faintest voice on the card — and this line is the one
                     sentence on the screen the reader has to believe before they trust the button under it. -->
                <TextView
                    android:id="@+id/accountStateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Not configured" />

                <!-- The account line and the sync line are read-outs, not headings: body-medium in the
                     secondary ink, which is the role the type scale gives to a sentence about state. -->
                <TextView
                    android:id="@+id/accountStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    tools:text="Signed in as Andrew" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signInButton"
                    style="@style/Widget.TaskPlanner.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/sign_in_google"
                    app:icon="@drawable/ic_google"
                    app:iconGravity="textStart" />

                <!-- Shown beside the disabled button, and only there. It says what is missing without pretending
                     the button works, and it names the file that explains how to provide it. -->
                <TextView
                    android:id="@+id/signInExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/sign_in_not_configured_explanation"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signOutButton"
                    style="@style/Widget.TaskPlanner.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/sign_out"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/localDataLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_normal"
                    android:text="@string/settings_local_data"
                    style="@style/Widget.TaskPlanner.SectionHeader"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/localProfileLayout"
                    style="@style/Widget.TaskPlanner.Field.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:hint="@string/local_profile_picker_hint"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/localProfileInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        tools:ignore="LabelFor" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/migrateLocalDataButton"
                    style="@style/Widget.TaskPlanner.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/migrate_local_data"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Said before the move rather than after it. This is the block\'s own answer to the question a
                     reader has to ask before pressing: which data, from where to where, and what happens to a
                     record both profiles hold. It used to be a string nothing referenced; the safety sentence it
                     replaces was written into the layout as a second note and merged back into this one, because
                     two paragraphs about the same button say less than one. -->
                <TextView
                    android:id="@+id/migrateSafetyNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/migrate_local_data_message"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The language the app is written in. Three rows, not a dropdown: a dropdown hides the two answers
             the reader is not currently using, and on a screen whose whole job is to say what state the app is
             in, a choice you have to open to see is the wrong control. Nothing here is `android:checked`: the
             layout must not guess which language this build is showing, which is the rule every other row on
             this screen follows, and `SettingsFragment.render()` sets it from the framework. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.TaskPlanner.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_horizontal">

                <TextView
                    style="@style/Widget.TaskPlanner.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/language_section_title" />

                <RadioGroup
                    android:id="@+id/languageGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/languageSystemDefault"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:paddingStart="@dimen/spacing_small"
                        android:paddingEnd="@dimen/spacing_small"
                        android:text="@string/language_system_default"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <!-- The two names are deliberately not translated (see `values/strings.xml`): each is
                         written in the script its own reader recognises. -->
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/languageEnglish"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:paddingStart="@dimen/spacing_small"
                        android:paddingEnd="@dimen/spacing_small"
                        android:text="@string/language_english"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/languageRussian"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target_min"
                        android:paddingStart="@dimen/spacing_small"
                        android:paddingEnd="@dimen/spacing_small"
                        android:text="@string/language_russian"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </RadioGroup>

                <TextView
                    android:id="@+id/languageNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/language_change_note"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            style="@style/Widget.TaskPlanner.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_horizontal">

                <TextView
                    style="@style/Widget.TaskPlanner.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sync" />

                <TextView
                    android:id="@+id/syncStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    tools:text="Pushed 4, pulled 2 at 18:20" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/syncNowButton"
                    style="@style/Widget.TaskPlanner.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/sync_now" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            style="@style/Widget.TaskPlanner.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_horizontal">

                <TextView
                    style="@style/Widget.TaskPlanner.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_backup" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/backup_scope_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Export is the panel's primary action and Import is its counterpart, so one carries the
                     filled role and the other the outlined one. Export used to be an unstyled MaterialButton
                     — the theme's default, which is filled — and naming the style says so out loud. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/exportButton"
                    style="@style/Widget.TaskPlanner.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/export_data" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/importButton"
                    style="@style/Widget.TaskPlanner.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/import_data" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/cloudNoticeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            android:text="@string/app_locked_message"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="Version 1.0" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/spacing_normal"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
