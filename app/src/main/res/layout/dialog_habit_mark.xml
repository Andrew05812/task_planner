<?xml version="1.0" encoding="utf-8"?>
<!-- The correction form for one kept day. Its own file because it is the same form the work interval uses in
     shape and a different one in meaning: a day left empty takes the mark back, a day written moves it, and the
     line above the fields says which day stands today so the two cannot be confused for each other. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/habitMarkStands"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceCaption"
        tools:text="It stands on Oct 14, 2026. Leave the day below empty to take it back." />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/habitMarkMoveInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/habit_correct_move_hint"
        android:inputType="date"
        android:maxLines="1" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/habitMarkReasonInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/habit_correct_reason_hint"
        android:inputType="textCapSentences"
        android:maxLines="3" />
</LinearLayout>
