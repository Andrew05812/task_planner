<?xml version="1.0" encoding="utf-8"?>
<!-- One stretch under an opened history entry, with the two things the user can do to a measurement that
     is already closed: correct it, or throw it away. Both act on this row only — the entry above stays,
     because a session is the record that work was begun. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/historyIntervalLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodySmall"
        tools:text="09:00 – 09:30, 30 min" />

    <!-- `Widget.TaskPlanner.IconButton` is the 48dp box the rest of the app uses. These two were 32dp
         inside the densest line on the screen — the row a reader corrects measured time in, and the row
         whose bin destroys it — and a target the thumb misses on a dense line is worse than on a sparse
         one. The glyph stays 24dp and centred; the box around it grows. -->
    <ImageButton
        android:id="@+id/historyIntervalEdit"
        style="@style/Widget.TaskPlanner.IconButton"
        android:contentDescription="@string/history_edit_interval"
        android:src="@drawable/ic_edit"
        app:tint="@color/ink_text" />

    <ImageButton
        android:id="@+id/historyIntervalDelete"
        style="@style/Widget.TaskPlanner.IconButton"
        android:contentDescription="@string/history_delete_interval"
        android:src="@drawable/ic_delete"
        app:tint="@color/ink_error" />
</LinearLayout>
