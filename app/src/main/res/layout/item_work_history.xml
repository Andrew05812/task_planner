<?xml version="1.0" encoding="utf-8"?>
<!-- One tracking session as the history list shows it: what was worked on, how much of it is a finished
     measurement, and — once opened — the stretches that make it up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/historyRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_medium"
    android:paddingTop="@dimen/spacing_small"
    android:paddingEnd="@dimen/spacing_medium"
    android:paddingBottom="@dimen/spacing_small">

    <!-- What was worked on, and the only line on this row that says so. Two lines before it is cut, the policy
         the task card's title has had since before this redesign: one line at 320dp leaves a session with a
         real name unreadable, and nothing else on the row identifies it. -->
    <TextView
        android:id="@+id/historyTaskTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        tools:text="Write the report" />

    <TextView
        android:id="@+id/historyWhen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        tools:text="18 Jun, 09:00 · 2 stretches · 1 entered by hand" />

    <TextView
        android:id="@+id/historyTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        tools:text="1 h 15 min" />

    <TextView
        android:id="@+id/historyRunning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/history_in_progress"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/historyIntervals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_xs" />
</LinearLayout>
