<?xml version="1.0" encoding="utf-8"?>
<!-- The custom period. Two whole days rather than a calendar control, for the same reason the interval
     form spells its instants out: what the screen filters on has to be traceable to what was typed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/rangeFromInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/history_from_hint"
        android:inputType="date"
        android:maxLines="1" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/rangeToInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/history_to_hint"
        android:inputType="date"
        android:maxLines="1" />
</LinearLayout>
