<?xml version="1.0" encoding="utf-8"?>
<!-- One day of the habit's week. Added as the cell of the grid the day of the month is written on: the panel
     and the colour of the number are set from the day's state, and the cell's press is what keeps the day or
     opens the correction. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="44dp"
    android:layout_weight="1"
    android:layout_margin="2dp"
    android:background="@drawable/bg_habit_day"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:textAppearance="?attr/textAppearanceBody2"
    tools:text="14" />
