<?xml version="1.0" encoding="utf-8"?>
<!-- The sentence for a list with no readings in it, drawn as a row of the same list rather than as a message
     laid over it: the panel above this line is the window the readings were taken against, and it stays true
     whether or not any rule spoke up. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/insightsEmpty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:paddingHorizontal="32dp"
    android:paddingVertical="24dp"
    android:textAppearance="?attr/textAppearanceBody1"
    android:textColor="?android:attr/textColorSecondary"
    tools:text="Nothing worth saying yet" />
