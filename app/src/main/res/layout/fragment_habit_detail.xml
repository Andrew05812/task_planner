<?xml version="1.0" encoding="utf-8"?>
<!-- One habit, the week it is being read on, and the record of its corrections.
     The card at the top is the same card the list draws — the same HabitCard words over the same figures the
     repository assembled — so the two screens cannot tell different stories about one row. What is only here is
     the grid and the corrections, because a day is kept, taken back and moved against the schedule the grid
     shows, and not against a line in a list. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ProgressBar
            android:id="@+id/habitDetailProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/habitNotFound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="24dp"
            android:text="@string/habit_not_found"
            android:textAppearance="?attr/textAppearanceBody1"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/habitCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/habitTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        tools:text="Run before breakfast" />

                    <TextView
                        android:id="@+id/habitState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_goal_state"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:visibility="gone"
                        tools:text="Owed today"
                        tools:visibility="visible" />

                </LinearLayout>

                <TextView
                    android:id="@+id/habitType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="On chosen weekdays" />

                <TextView
                    android:id="@+id/habitSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:visibility="gone"
                    tools:text="Mon, Wed, Fri"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/habitFigure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    tools:text="6 days running" />

                <TextView
                    android:id="@+id/habitBest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone"
                    tools:text="Longest 21 days"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/habitWeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone"
                    tools:text="3 of 4 this week"
                    tools:visibility="visible" />

                <com.taskplanner.ui.components.StackedBarView
                    android:id="@+id/habitBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/habitKept"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone"
                    tools:text="75% kept, over the last 28 days"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/habitMarks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone"
                    tools:text="18 days kept in that window"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/habitMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone"
                    tools:text="Since Sep 1, 2026  ·  Reminded at 07:00"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/habitArchivedNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_goal_state"
                    android:padding="8dp"
                    android:text="@string/habit_archived_note"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keepToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/habit_keep" />

        <TextView
            android:id="@+id/habitGridTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/habit_detail_grid"
            android:textAppearance="?attr/textAppearanceSubtitle2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/weekBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/habit_week_back"
                android:padding="@dimen/spacing_small"
                android:scaleX="-1"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/weekLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBody2"
                tools:text="Oct 12 – Oct 18" />

            <ImageButton
                android:id="@+id/weekForward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/habit_week_forward"
                android:padding="@dimen/spacing_small"
                android:src="@drawable/ic_chevron_right"
                app:tint="?attr/colorPrimary" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/habitDayLabels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/habitDayCells"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/habitHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/habit_day_hint"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/habitHistoryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/habit_detail_history"
            android:textAppearance="?attr/textAppearanceSubtitle2" />

        <LinearLayout
            android:id="@+id/habitHistoryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/habitHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/habit_detail_empty_history"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editHabit"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/habit_edit"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/archiveHabit"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/habit_archive"
            app:icon="@drawable/ic_archive"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteHabit"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/habit_delete"
            android:textColor="@color/error"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
