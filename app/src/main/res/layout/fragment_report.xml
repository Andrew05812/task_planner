<?xml version="1.0" encoding="utf-8"?>
<!-- A report: the question it was asked (period, timezone), the document that answers it, and the two ways
     that document leaves the app.

     The three rows above the scrolling document are fixed on purpose. A reader who has chosen a month and a
     timezone must be able to see both while looking at a figure three pages down, because a report whose header
     has scrolled away is a document that no longer says what period it describes — the one thing §6 asks every
     report to state. The Save and Share row is fixed for the same reason: they belong to the report as a whole,
     not to whichever page happens to be on screen.

     Everything inside the document is either the pages the exporter writes, or the lines of the file it writes.
     There is no second rendering of the figures here, and that is deliberate: a screen that laid the numbers out
     its own way would be a second document, able to disagree with the file beside it. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <HorizontalScrollView
        android:id="@+id/reportKindScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/reportKindChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true"
            />
    </HorizontalScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/reportQuestion"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_normal"
        android:layout_marginEnd="@dimen/spacing_normal"
        app:layout_constraintTop_toBottomOf="@id/reportKindScroll">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_normal">

            <TextView
                android:id="@+id/reportWindowLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Jun 1, 2026 – Jun 30, 2026" />

            <TextView
                android:id="@+id/reportZoneLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Europe/Berlin · UTC+02:00 · the device's own timezone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reportDatesButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/report_dates_button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reportZoneButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:text="@string/report_zone_button" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- A complaint about the read, kept on the screen rather than in a toast: the reader has to be able to see
         what is missing while deciding whether to retry, and a message that disappears in four seconds leaves an
         empty document with no reason attached to it. -->
    <LinearLayout
        android:id="@+id/reportProblem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_normal"
        android:layout_marginEnd="@dimen/spacing_normal"
        android:background="?attr/colorErrorContainer"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_small"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/reportQuestion"
        tools:visibility="visible">

        <TextView
            android:id="@+id/reportProblemText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnErrorContainer"
            tools:text="The report could not be read." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reportRetryButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_retry" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reportViewRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_normal"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_normal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/reportProblem">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/reportFormatChips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/reportFormatPdf"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/report_format_pdf" />

            <com.google.android.material.chip.Chip
                android:id="@+id/reportFormatCsv"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/report_format_csv" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reportZoomOut"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/report_zoom_out"
            app:icon="@drawable/ic_zoom_out" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reportZoomIn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/report_zoom_in"
            app:icon="@drawable/ic_zoom_in" />
    </LinearLayout>

    <TextView
        android:id="@+id/reportViewNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_normal"
        android:layout_marginEnd="@dimen/spacing_normal"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/reportViewRow"
        tools:text="3 pages" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/reportDocumentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_small"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_normal"
        app:layout_constraintBottom_toTopOf="@id/reportActions"
        app:layout_constraintTop_toBottomOf="@id/reportViewNote">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- The pages, at whatever width the zoom asks for, inside a scroller that only scrolls sideways when
                 the reader has asked for a sheet wider than the screen. -->
            <HorizontalScrollView
                android:id="@+id/reportPagesScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/spacing_normal"
                android:paddingEnd="@dimen/spacing_normal"
                android:scrollbars="horizontal">

                <com.taskplanner.ui.report.ReportPreviewView
                    android:id="@+id/reportPages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/reportCsv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_normal"
                android:layout_marginEnd="@dimen/spacing_normal"
                android:background="?attr/colorSurface"
                android:fontFamily="monospace"
                android:padding="@dimen/spacing_small"
                android:textIsSelectable="true"
                android:textSize="@dimen/text_caption"
                android:visibility="gone"
                tools:visibility="gone" />

            <ProgressBar
                android:id="@+id/reportProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                tools:visibility="gone" />

            <TextView
                android:id="@+id/reportEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/spacing_large"
                android:layout_marginEnd="@dimen/spacing_large"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:visibility="gone"
                tools:text="@string/report_empty_no_profile"
                tools:visibility="gone" />
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/reportActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_normal"
        android:paddingEnd="@dimen/spacing_normal"
        android:paddingBottom="@dimen/spacing_small"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reportSaveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/report_action_save"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reportShareButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1"
            android:text="@string/report_action_share"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart" />

        <ProgressBar
            android:id="@+id/reportBusy"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
