<?xml version="1.0" encoding="utf-8"?>
<!-- One recorded correction of a kept day: which day the user walked back or moved, where it went, when, and
     why they said it did. The row is the reason "the user missed Tuesday" and "the user marked Tuesday and then
     said that was a mistake" are two different histories rather than one empty grid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/habitChangeWhat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBody2"
        tools:text="Moved Oct 14, 2026 to Oct 15, 2026" />

    <TextView
        android:id="@+id/habitChangeWhen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="?android:attr/textColorSecondary"
        tools:text="Oct 15, 2026, 09:12 — it was the day that was wrong" />

</LinearLayout>
