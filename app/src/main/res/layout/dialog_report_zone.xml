<?xml version="1.0" encoding="utf-8"?><!-- The zone a report is counted in, out of the several hundred the device
     knows. A search box rather than a short list of favourites, because §3 asks for a long list to be reachable:
     a reader whose working week lives in Asia/Almaty should not have to accept Europe/London because those were
     the four timezones somebody thought to write down.

     The device's own zone is offered as its own button rather than only as the first row of the list, because a
     reader who has searched their way to Tokyo has to be able to get back to their own calendar in one press. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_normal"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_normal"
        android:hint="@string/report_zone_search_hint"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/reportZoneSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reportZoneDevice"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_normal"
        android:layout_marginEnd="@dimen/spacing_normal"
        android:text="@string/report_zone_device"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- A height rather than wrap_content: an unbounded list measures every row it is handed before it draws
         one, and this one is handed several hundred when the search box is empty. A band the reader scrolls
         costs the dialog the rows it can actually see. -->
    <ListView
        android:id="@+id/reportZoneList"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_xs"
        android:scrollbars="vertical" />

</LinearLayout>
