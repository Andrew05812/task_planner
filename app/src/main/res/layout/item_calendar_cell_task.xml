<?xml version="1.0" encoding="utf-8"?>
<!--
    One task inside a day cell: its title, wearing the colour of its category. The dot is the colour
    the cell's legend carries; a task with no category gets no dot rather than an invented one.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="1dp">

    <View
        android:id="@+id/taskDot"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/calendar_dot" />

    <TextView
        android:id="@+id/taskTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/on_surface"
        android:textSize="11sp"
        tools:text="Buy the birthday present" />

</LinearLayout>
