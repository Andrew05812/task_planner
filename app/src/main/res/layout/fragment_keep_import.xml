<?xml version="1.0" encoding="utf-8"?>
<!--
  Importing a pasted Google Keep text export (Stage 15).

  Two phases in one screen, and only one of them is measurable at a time: the paste field is a NestedScrollView
  that grows with whatever the reader pasted, and the preview is a RecyclerView that has to recycle, because the
  user's own export is 439 lines and 382 rows in a scroll container would build every one of them at once.
  Swapping the two containers is what lets each use the scrolling it needs rather than fighting the other.

  `fillViewport` matters on the first phase: with a short paste the field would sit at its own min height and the
  buttons would float under it instead of reading as one panel.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.keep.KeepImportFragment">

    <!-- ================================================================ phase one: the paste -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/pasteScroller"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingTop="@dimen/spacing_normal"
            android:paddingBottom="@dimen/spacing_normal">

            <TextView
                android:id="@+id/keepImportTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_keep_import"
                android:textAppearance="@style/TextAppearance.TaskPlanner.Headline" />

            <TextView
                android:id="@+id/keepImportEntryHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/settings_keep_import_hint"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/pasteFieldLayout"
                style="@style/Widget.TaskPlanner.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_normal"
                android:hint="@string/keep_import_paste_label">

                <!-- The leading whitespace on a line *is* the data: it is what makes an indented line a task of
                     the topic above it rather than a topic of its own. So nothing here trims: no `trim`, no
                     autoCorrect that would rewrite a word, and the text grows with the paste rather than scrolling
                     inside its own box, because a field that scrolls inside a scrolling screen takes two gestures
                     to read and the reader cannot tell which one moved. -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pasteInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:hint="@string/keep_import_paste_placeholder"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minLines="10"
                    android:maxLines="90"
                    android:scrollHorizontally="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Said before the reader parses rather than after, because these are the three answers they have to
                 trust before pasting their notebook into the box: nothing is invented, a topic keeps its own mark,
                 and an import merges rather than replaces. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_normal"
                android:text="@string/keep_import_metadata_note"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/keep_import_topic_state_note"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/keep_import_merge_note"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/parseButton"
                style="@style/Widget.TaskPlanner.Button.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_normal"
                android:text="@string/keep_import_parse" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearButton"
                style="@style/Widget.TaskPlanner.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/keep_import_clear" />

            <ProgressBar
                android:id="@+id/pasteProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/spacing_normal"
                android:contentDescription="@string/keep_import_loading"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/pasteMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:visibility="gone"
                tools:text="@string/keep_import_result_already"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ================================================================ phase two: the preview -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/previewList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_normal"
        android:scrollbars="vertical"
        android:visibility="gone"
        tools:listitem="@layout/item_keep_preview_row"
        tools:visibility="visible" />

    <!-- The confirm lives in a bar of its own rather than at the bottom of the list: it is the one control that
         has to be reachable without scrolling 382 rows, and §6 asks for it to appear only once the reader has a
         preview in front of them. -->
    <LinearLayout
        android:id="@+id/confirmBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_small"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/confirmMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="@string/keep_import_result_already" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToTextButton"
                style="@style/Widget.TaskPlanner.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/keep_import_paste_label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmButton"
                style="@style/Widget.TaskPlanner.Button.Filled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/keep_import_confirm" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/confirmProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/keep_import_loading"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
