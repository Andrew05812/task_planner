    <item
        android:id="@+id/action_new_group"
        android:title="@string/new_group" />

    <item
        android:id="@+id/action_archive"
        android:title="@string/action_archive" />

    <item
        android:id="@+id/action_work_history"
        android:title="@string/action_work_history" />
</menu>
