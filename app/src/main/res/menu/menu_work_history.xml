<?xml version="1.0" encoding="utf-8"?>
<!-- The order the history list is read in. One item per statement the DAO holds, so choosing an order
     here cannot silently fall back to a sort the screen never asked for. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/action_history_sort"
        android:icon="@drawable/ic_sort"
        android:title="@string/history_sort_title"
        app:showAsAction="ifRoom">
        <menu>
            <group android:checkableBehavior="single">
                <item
                    android:id="@+id/action_sort_date"
                    android:title="@string/history_sort_date" />
                <item
                    android:id="@+id/action_sort_duration"
                    android:title="@string/history_sort_duration" />
                <item
                    android:id="@+id/action_sort_task"
                    android:title="@string/history_sort_task" />
            </group>
        </menu>
    </item>
</menu>
