<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The fifteen component styles spec §3.5 lists: its fourteen, plus `Field.Dropdown`, which the spec's
         list omits but five uses across two layouts require — those layouts name
         `Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu` today, and a plain
         `Field` cannot replace a dropdown without losing it.

         1.5a declared these as names over the Material 3 parent each one replaces, because `aapt2 link`
         resolves a theme's `@style/…` value at link time and themes.xml names three of them. The bodies
         below are the shape and spacing decisions of spec §3.4 — radius 14 for a card, 12 for a control,
         pill fully round; elevation used twice at most; 48dp as the floor for anything a finger hits — and
         deliberately nothing else. What a component *means* in a given state (a completed card, a
         destructive row, a category chip) is chosen from the row's data at bind time, which is why §3.5
         files StatusPill and PriorityRule under "drawables plus bind-time code" rather than here, and why
         `Card.Completed` below carries no colour: a style cannot know the task is finished.

         Nothing here changes a layout's structure or a screen's behaviour: `labelVisibilityMode` stays on the
         bar in `activity_main` because it is a decision about that screen's five destinations rather than a
         property of the widget, and the header, the swipe panel and the pill colours belong to the stages
         that name them (§18). -->

    <style name="Widget.TaskPlanner.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeWidth">0dp</item>
        <!-- No `contentPadding` here, on purpose. Spec §3.4's 14/16 is what a redesigned card pads, but
             this style is also what `materialCardViewStyle` hands every `MaterialCardView` in the app from
             stage 1 onward — so padding set here moves every screen at once, including the eleven stages
             that have not been restyled yet. `StatisticsLayoutTest` caught it by measuring the dashboard's
             own 16dp inset and finding 14: the test was right, and the place the decision belongs is the
             layout that opts into it. -->
    </style>

    <!-- The completed card is the same card. What makes it read as finished — the struck-through title and
         the dimmed meta line — is a fact about the row, so it is applied where the row is bound (4.4), not
         by a style that cannot see the data. This name exists so the layout can ask for it and the bind
         code has one place to answer. -->
    <style name="Widget.TaskPlanner.Card.Completed" parent="Widget.TaskPlanner.Card" />

    <style name="Widget.TaskPlanner.Button.Filled" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.TaskPlanner.Label</item>
    </style>

    <style name="Widget.TaskPlanner.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.TaskPlanner.Label</item>
    </style>

    <style name="Widget.TaskPlanner.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.TaskPlanner.Label</item>
    </style>

    <style name="Widget.TaskPlanner.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.TaskPlanner.Label</item>
    </style>

    <!-- Destructive is an outlined button in the error role, not a filled red slab: filled red draws the
         eye to the one action that should be the quietest thing on the screen. -->
    <style name="Widget.TaskPlanner.Button.Destructive" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/ink_error</item>
        <item name="iconTint">@color/ink_error</item>
        <item name="strokeColor">@color/ink_error</item>
        <item name="android:textAppearance">@style/TextAppearance.TaskPlanner.Label</item>
    </style>

    <style name="Widget.TaskPlanner.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background_ink</item>
        <item name="chipStrokeColor">@color/chip_stroke_ink</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="chipMinHeight">@dimen/touch_target_min</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/ink_text</item>
        <item name="android:textAppearance">@style/TextAppearance.TaskPlanner.Label</item>
        <!-- Caps off, and that is not a style preference. This style is what `chipStyle` hands every chip
             in the app that does not name one, and the chips it reaches first carry *user data* — the
             category rail's "Диссертация" came back as "ДИССЕРТАЦИЯ" the moment the label role was applied.
             A word the reader typed is not a section heading; §3.3 keeps the caps for labels, which a
             screen writes itself. -->
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- A category is chosen the same way a filter is, so it gets the same behaviour; what it must not do
         is wear the category's own colour as its text, which is audit finding 3. The colour belongs to the
         dot beside the name, drawn at bind time (4.4). -->
    <style name="Widget.TaskPlanner.Chip.Category" parent="Widget.TaskPlanner.Chip.Filter" />

    <!-- A filter chip whose checked state is a fact the reader has to be able to recover without seeing the
         fill. `Chip.Filter` above hides the check mark because the chips it was made for — the category rail,
         the status row — are single-choice filters where the pill *is* the choice. The task editor's chips
         are different: "15 min before" and "Tuesday" are ticked independently, and one of them ticked is a
         reminder that will fire or a day the task will come back on. A fill alone would make that a colour
         difference, and the brief's own rule is that colour is never the only indicator. So the mark the
         platform chip has is put back, tinted with the ink the label is written in so it holds in both
         themes. Owned here rather than at each chip because the editor has fourteen of them. -->
    <style name="Widget.TaskPlanner.Chip.State" parent="Widget.TaskPlanner.Chip.Filter">
        <item name="checkedIcon">@drawable/ic_check_chip</item>
        <item name="checkedIconTint">@color/ink_text</item>
        <item name="checkedIconVisible">true</item>
    </style>

    <!-- Every field in the app. `boxStrokeColor` is spelled out rather than left to the parent because the
         parent resolves to ?attr/colorOutline, which in this design is the decorative hairline: see
         res/color/field_stroke_ink.xml, whose resting entry is the strong outline, and the test that
         measures it (`ComponentStyleTest`, "a field's resting outline is legible against the page"). -->
    <style name="Widget.TaskPlanner.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_control</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/field_stroke_ink</item>
    </style>

    <style name="Widget.TaskPlanner.Field.Dropdown"
        parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_control</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/field_stroke_ink</item>
    </style>

    <!-- A control that says what it is by its shape alone, so it carries a contentDescription at every use
         site and a touch target that does not depend on the glyph's size. -->
    <style name="Widget.TaskPlanner.IconButton" parent="android:Widget.ImageButton">
        <item name="android:layout_width">@dimen/touch_target_min</item>
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">@dimen/spacing_small</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/ink_text_secondary</item>
    </style>

    <style name="Widget.TaskPlanner.BottomBar" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.TaskPlanner.BottomBar.Indicator</item>
        <item name="elevation">0dp</item>
        <!-- The word and the icon above it, in the design's two text roles rather than one flat colour:
             the audit's baseline pinned both to `ink_text_secondary`, so the chosen tab was told by the plate
             alone. The text needs no override — Material's own pair is `colorOnSurface` when checked and
             `colorOnSurfaceVariant` otherwise, which this theme maps to `ink_text` (17.97:1 on the bar in
             light, 15.20:1 in night) and `ink_text_secondary` (5.89:1 / 6.45:1), and its selector also keeps
             the eight pressed/focused/hovered entries a two-state list would drop. The icon does need one:
             the library's active icon is `colorOnSecondaryContainer`, which here is `ink_accent`, and §4.4
             asks for `ink_text` — so `nav_item_icon_ink.xml` is the library's own selector with that one
             entry re-pointed, not a shorter list.

             What neither override does is mark keyboard/D-pad focus as *focus*: in the library, as in this
             mirror, a focused unchosen tab takes `colorOnSurface` and so wears the chosen tab's colour. The
             plate now makes the choice itself visible, which is what §4.3 asks of this stage; a focus-visible
             ring is Stage 10's item, already listed in the plan. -->
        <item name="itemIconTint">@color/nav_item_icon_ink</item>
        <!-- Five labels share 320dp. Material's nav label inherits `?attr/textAppearanceLabelMedium`, which
             this theme maps to the all-caps `Label` role, and on the device that spelled "CATEGOR…" and
             "STATISTI…"; the nav role is sentence case at the same size. `BottomNavigationInstrumentedTest`
             refuses a label whose layout reports an ellipsis (`getEllipsisCount`), so this claim is measured
             on the rendered bar and not assumed from the style. -->
        <item name="itemTextAppearanceActive">@style/TextAppearance.TaskPlanner.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.TaskPlanner.NavLabel</item>
    </style>

    <!-- The plate the selected tab's icon sits in.

         Size and shape are the library's own and deliberately not re-declared: `Widget.Material3
         .BottomNavigationView.ActiveIndicator` is 64dp x 32dp with `marginHorizontal` 4dp and
         `ShapeAppearance.M3.Comp.NavigationBar.ActiveIndicator.Shape`, which is
         `ShapeAppearance.M3.Sys.Shape.Corner.Full` — a fully round stadium. An earlier draft of this stage
         narrowed it to `icon_container` x `spacing_large` (40dp x 24dp) for tidiness, and that is the size
         that clips a 24dp glyph: the stadium's ends are semicircles of radius 12dp, so at the icon's own left
         and right edges the plate has no height left, and the corners of a squared-off icon such as
         `ic_task` sit outside it. 64x32 is the only size here that puts the platform's 24dp icon inside the
         plate with room on every side — 20dp left and right, 4dp above and below.
         `BottomNavigationInstrumentedTest` measures the drawn plate against the drawn glyph and refuses the
         pair when the glyph is not contained, so this is a claim with a check behind it rather than a
         comment with a memory.

         The colour is the design's own contribution, and it is not the chips' pill: WCAG 1.4.11 asks 3:1 of
         the visual that tells a component's state, and `pill_accent` measures 1.12:1 against the bar in light
         and 1.33:1 in night, which is a tint no reader can find — the selection would then be carried by the
         ink pair alone, the one cue the design spec forbids. `ink_nav_plate` is 3.55:1 (light) and 3.14:1
         (night) against the bar's own surface, and `ink_text` — the word and glyph drawn on it — measures
         5.06:1 (light) and 4.84:1 (night) against the plate, so 1.4.11 and 1.4.3 both hold at once.
         `scripts/contrast_report.py`, reading the pairs declared in `docs/design/tokens.json` — where
         `ink_nav_plate` sits on `ink_surface` as a state-bearing graphic and `ink_text` sits on it as text —
         is what computes those four numbers from the hexes that ship, and `BottomNavigationStyleTest` asserts
         the same two pairs from the colours this widget's theme resolves. -->
    <style name="Widget.TaskPlanner.BottomBar.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/ink_nav_plate</item>
    </style>

    <!-- A dialog is a theme overlay, not a widget style: there is no `Widget.Material3.Dialog` to inherit,
         and pretending otherwise would be a name that silently draws nothing. -->
    <style name="Widget.TaskPlanner.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TaskPlanner.Dialog</item>
    </style>

    <style name="ShapeAppearance.TaskPlanner.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sheet</item>
    </style>

    <style name="Widget.TaskPlanner.MetaText" parent="android:Widget.TextView">
        <item name="android:textAppearance">@style/TextAppearance.TaskPlanner.Meta</item>
    </style>

    <style name="Widget.TaskPlanner.SectionLabel" parent="android:Widget.TextView">
        <item name="android:textAppearance">@style/TextAppearance.TaskPlanner.Label</item>
        <item name="android:textColor">@color/ink_text_secondary</item>
    </style>

    <!-- A level-1 heading, and the reason it is not `SectionLabel` is measured rather than tasted: six
         boundaries in a form the reader works through top to bottom have to be found by eye before the
         fields under them are read, and an 11sp all-caps secondary grey is the same voice the field labels
         and the captions in this screen already speak in — the first run of this screen photographed at
         393dp read as one long form with two small grey words in it. `title` (16sp, medium, `ink_text`) is
         the role the type scale has for "this is a heading", and it is deliberately not `headline`: spec
         3.3 gives `headline` to a screen's own title, and six 22sp headings inside a scrolling form would
         compete with the one heading that names the screen. `SectionLabel` stays for level-2 headings — the
         "Plan" block inside When, which must sit under its section and not beside it. No margin here on
         purpose: the gap between two sections belongs to the section block, so a heading can never be
         moved out of step with the block it names. -->
    <style name="Widget.TaskPlanner.SectionHeader" parent="android:Widget.TextView">
        <item name="android:textAppearance">@style/TextAppearance.TaskPlanner.Title</item>
        <item name="android:textColor">@color/ink_text</item>
    </style>
</resources>
