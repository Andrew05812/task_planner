<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Design 3 colors -->
    <color name="primary">#FF6750A4</color>
    <color name="primary_dark">#FF4F378B</color>
    <color name="secondary">#FFE8DEF8</color>
    <color name="secondary_dark">#FFD0BCFF</color>
    <color name="background">#FFFFFFFF</color>
    <color name="background_dark">#FF1C1B1F</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_dark">#FF1C1B1F</color>
    <color name="error">#FFB3261E</color>
    <color name="on_error">#FFFFFFFF</color>
    <color name="on_surface">#FF1C1B1F</color>
    <color name="on_surface_dark">#FFE6E1E5</color>

    <!-- Basic colors -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="transparent">#00000000</color>

    <!-- Task priority colors -->
    <color name="priority_low">#43A047</color>
    <color name="priority_medium">#FB8C00</color>
    <color name="priority_high">#E53935</color>

    <!-- Task status colors -->
    <color name="status_todo">#FFBDBDBD</color>
    <color name="status_in_progress">#FF2196F3</color>
    <color name="status_done">#FF4CAF50</color>
    <color name="status_paused">#FFFFA000</color>
    <!-- The panel a state word sits on. Colourless by design: the state's own colour goes on the word, so
         the panel only has to separate it from the card, on the light theme and the dark one. -->
    <color name="state_badge_fill">#14000000</color>
    <color name="red">#FFFF0000</color>

    <!-- Swipe action panel -->
    <color name="action_edit">#FF1976D2</color>
    <color name="action_delete">#FFD32F2F</color>
    <color name="material_grey_600">#FF757575</color>

    <!-- Dashboard charts -->
    <!-- The shades are the accent at rising alpha rather than six different hues: a reader has to be able
         to tell a busy week from a quiet one by how full a square looks, and that ordering survives a
         colour-blind eye and a black-and-white print, which hues do not. -->
    <color name="chart_bar">@color/primary</color>
    <color name="chart_axis">#33757575</color>
    <color name="chart_track">#1F757575</color>
    <!-- The completions bar sits under the work bar and says something else about the same days, so it
         borrows the green the list already marks a finished task with instead of a second accent. -->
    <color name="chart_completions">@color/status_done</color>
    <!-- Work with no category is not a category, and giving it the accent would let it read as the
         default one. It takes the grey the health panel uses for "nothing to hang this on". -->
    <color name="chart_category_none">#FF9E9E9E</color>
    <color name="chart_heatmap_none">#14757575</color>
    <color name="chart_heatmap_1">#4D6750A4</color>
    <color name="chart_heatmap_2">#806750A4</color>
    <color name="chart_heatmap_3">#B36750A4</color>
    <color name="chart_heatmap_4">#FF6750A4</color>
    <!-- The health panel's buckets borrow the colours the rest of the app already uses for the same
         states, so "late" is the red the list marks it with and not a new one to learn. -->
    <color name="health_overdue">@color/error</color>
    <color name="health_due_today">#FFF57C00</color>
    <color name="health_due_week">#FF00897B</color>
    <!-- The bucket SQLite does not count, only the remainder of: open, dated, and far enough off that the
         week's colours have nothing to say about it. Cool, so the bar reads as heating toward today. -->
    <color name="health_due_later">#FF42A5F5</color>
    <color name="health_without_deadline">#FF9E9E9E</color>
    <color name="health_in_progress">@color/status_in_progress</color>
    <color name="health_stale">#FF7E57C2</color>

    <!-- Reports, printed. Paper is never dark, so the five colours a report draws with are written out here
         instead of borrowed from the theme: the same hues the screens already use for the same claims — the
         accent for a heading, the app's ink for text, its grey for a qualification, the green of a finished
         task for finished work — fixed at one value so a report printed at midnight and a report printed at
         noon look identical, which is what a document a reader keeps has to be. -->
    <color name="report_ink">#FF1C1B1F</color>
    <color name="report_accent">#FF6750A4</color>
    <color name="report_muted">#FF757575</color>
    <color name="report_finished">#FF4CAF50</color>
    <color name="report_hairline">#33757575</color>
    <!-- Work nobody filed, and work whose category has since been deleted: the grey the dashboard gives the
         same bucket, so a chart in a report and the bar beside it on the screen agree. -->
    <color name="report_category_none">#FF9E9E9E</color>
</resources>